{
  "name": "eazybookz-app",
  "version": "1.0.0",
  "description": "EazyBookz desktop app",
  "main": "main.js",
  "author": "EazyBookz",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.eazybookz.app",
    "productName": "EazyBookz",
    "directories": {
      "output": "dist"
    },
    "files": ["main.js"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.finance" },
    "linux": { "target": "AppImage" }
  }
}
