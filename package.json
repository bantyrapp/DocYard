{
  "name": "eazybookz",
  "private": true,
  "version": "1.0.0",
  "description": "EazyBookz – trial balance to Yardi journal entries",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "push": "git add -A && git status",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "electron:dev": "concurrently \"npm run dev:client\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:pack": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.eazybookz.app",
    "productName": "EazyBookz",
    "directories": { "output": "release" },
    "files": ["electron/**", "client/dist/**", "client/public/icon.png"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "client/public/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "client/public/icon.png",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "client/public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
