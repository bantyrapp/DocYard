# DocYard client – copy to .env and fill in (Vite exposes VITE_* only)

# Supabase (auth) – from Supabase project Settings → API (use anon/public key)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Optional: API base URL when not using Vite proxy (e.g. production)
# VITE_API_URL=https://api.yourapp.com
