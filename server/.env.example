# ===========================================
# DocYard server – copy to .env and fill in
# ===========================================

# Admin (required for /admin stats)
ADMIN_SECRET=your-admin-secret-here

# Server
PORT=4000
NODE_ENV=development

# Stripe (payments – get keys from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
# Optional: for Stripe redirects in production
# FRONTEND_URL=https://yourapp.com

# Railway Postgres (from Railway project → Postgres → Connect → DATABASE_URL)
# DATABASE_URL=postgresql://user:password@host:port/railway

# Supabase (auth & users – from Supabase project Settings → API)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  (server-only; never expose in client)
